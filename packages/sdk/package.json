{
  "name": "@alchemy/sdk",
  "version": "0.0.0",
  "description": "Shared Alchemy API clients for developer tools",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./dist/config/index.js"
    },
    "./evm": {
      "types": "./src/evm/index.ts",
      "import": "./dist/evm/index.js"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "import": "./dist/data/index.js"
    },
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./dist/admin/index.js"
    },
    "./surfaces": {
      "types": "./src/surfaces/index.ts",
      "import": "./dist/surfaces/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.47.10"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
