{
  "name": "alchemy",
  "private": true,
  "version": "0.0.0",
  "description": "Alchemy developer tools monorepo",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev:cli": "pnpm --filter @alchemy/cli dev",
    "dev:mcp": "pnpm --filter @alchemy/mcp-server dev",
    "lint": "pnpm -r --if-present run lint",
    "postinstall": "node ./scripts/postinstall.cjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "update:skills": "npx skills update && pnpm sync:skills",
    "test": "pnpm -r --if-present run test",
    "test:cli:e2e": "pnpm --filter @alchemy/cli test:e2e",
    "test:cli:live": "pnpm --filter @alchemy/cli test:live",
    "mcp:docker:build": "docker build -f apps/mcp-server/Dockerfile .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "pnpm": {
    "packageExtensions": {
      "@alchemy/common@5.0.0-beta.4": {
        "dependencies": {
          "zod": "^3.23.0"
        }
      }
    },
    "overrides": {
      "typebox": "1.0.81"
    }
  }
}
