{
  "name": "@alchemy/mcp-server",
  "version": "0.3.5",
  "description": "Alchemy MCP server with Streamable HTTP transport",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:skills": "npx skills update && pnpm sync:skills"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
